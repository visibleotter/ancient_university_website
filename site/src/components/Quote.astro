---
// Цитата из источника: греческий текст (если есть), перевод, место, пометки.
import { render } from 'astro:content';
import { one } from '../lib/content';
import { mt, type Locale } from '../i18n/ui';
interface Props { id: string; locale: Locale }
const { id, locale } = Astro.props;
const t = mt[locale];
const q = await one('quotes', locale, id);
const d = q.entry.data;
const { Content } = await render(q.entry);
---
<blockquote class="quote" id={`q-${id}`}>
  <p class="src"><b>{d.author}</b>, «{d.work}», {d.locus}</p>
  {d.greek && <p class="greek" lang="grc"><i>{d.greek}</i></p>}
  <div class="tr"><Content /></div>
  <p class="meta">
    {d.greek ? (d.greekVerified ? t.greekOk : t.greekNo) : t.greekNo}
    {d.eudemus && t.eud[d.eudemus] && <> · {t.eud[d.eudemus]}</>}
  </p>
  {d.note && <p class="note">{d.note}</p>}
</blockquote>
<style>
  .quote { border-left: 3px solid #c8102e; margin: 1rem 0; padding: .25rem 1rem; background: #faf7f0; }
  .src, .meta, .note { font-size: .85rem; }
  .meta { color: #777; }
  .greek { font-family: Georgia, serif; white-space: pre-line; }
</style>
