---
// Все карточки сайта: по мирам (и сквозным линиям) и типам, с фильтром по возрасту.
import Base from '../../../layouts/Base.astro';
import CardLink from '../../../components/CardLink.astro';
import { localePaths, toLocale, mt, href } from '../../../i18n/ui';
import { all, worldList } from '../../../lib/content';
import { AGES, CARD_TYPES } from '../../../content.config';
export function getStaticPaths() {
  return localePaths();
}
const locale = toLocale(Astro.params.locale);
const m = mt[locale];
const cards = [...(await all('cards', locale)).values()];
const groups = [
  ...(await worldList(locale)).map((w) => ({ id: w.id, title: w.entry.data.title })),
  { id: '', title: `${m.areas.method} · ${m.areas.monuments}` }, // карточки без мира
];
---
<Base locale={locale} title={m.allCards} path="cards" fallback={cards.some((c) => c.fallback)}>
  <h1>{m.allCards} ({cards.length})</h1>
  <p class="ages">
    <a href="#" data-age="">{m.all}</a>
    {AGES.map((a) => <a href={`#age-${a}`} data-age={a}>{m.ages[a]}</a>)}
  </p>
  {groups.map((g) => {
    const inG = cards.filter((c) => (c.entry.data.world ?? '') === g.id);
    return inG.length > 0 && (
      <section>
        <h2>{g.id ? <a href={href(locale, g.id)}>{g.title}</a> : g.title} ({inG.length})</h2>
        {CARD_TYPES.map((ty) => {
          const list = inG.filter((c) => c.entry.data.type === ty).sort((x, y) => x.entry.data.level - y.entry.data.level || x.entry.data.title.localeCompare(y.entry.data.title));
          return list.length > 0 && <><h3>{m.types[ty]} ({list.length})</h3><ul>{list.map((c) => <CardLink c={c} locale={locale} />)}</ul></>;
        })}
      </section>
    );
  })}
</Base>
<script>
  // Фильтр по возрасту через #age-…, чтобы ссылки на возраст работали сразу.
  const apply = () => {
    const a = location.hash.startsWith('#age-') ? location.hash.slice(5) : '';
    document.querySelectorAll<HTMLElement>('li[data-ages]').forEach((li) => { li.hidden = !!a && !li.dataset.ages!.split(' ').includes(a); });
    document.querySelectorAll<HTMLElement>('.ages a').forEach((x) => (x.style.fontWeight = x.dataset.age === a ? '700' : '400'));
  };
  window.addEventListener('hashchange', apply);
  document.querySelector('.ages a[data-age=""]')?.addEventListener('click', (e) => { e.preventDefault(); history.replaceState(null, '', location.pathname); apply(); });
  apply();
</script>
