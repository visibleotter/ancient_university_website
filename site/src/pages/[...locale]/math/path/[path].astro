---
// Маршрут: упорядоченная цепочка карточек с разделами.
import Base from '../../../../layouts/Base.astro';
import CardLink from '../../../../components/CardLink.astro';
import { locales, defaultLocale, toLocale, mt, href } from '../../../../i18n/ui';
import { all, ids, one } from '../../../../lib/content';
export async function getStaticPaths() {
  const list = await ids('paths');
  return locales.flatMap((l) => list.map((path) => ({ params: { locale: l === defaultLocale ? undefined : l, path } })));
}
const locale = toLocale(Astro.params.locale);
const m = mt[locale];
const p = await one('paths', locale, Astro.params.path!);
const cards = await all('cards', locale);
const d = p.entry.data;
---
<Base locale={locale} title={d.title} path={`math/path/${p.id}`} fallback={p.fallback}>
  <p><a href={href(locale, 'math')}>← {mt[locale].start}</a></p>
  <h1>{d.title}</h1>
  <p>{d.summary}</p>
  <p>{d.ages.map((a) => m.ages[a]).join(' · ')}</p>
  {d.sections.map((s, i) => (
    <section>
      <h2>{i + 1}. {s.title}</h2>
      {s.text && <p>{s.text}</p>}
      <ol>{s.cards.map((id) => { const c = cards.get(id); if (!c) throw new Error(`Маршрут ${p.id}: нет карточки ${id}`); return <CardLink c={c} locale={locale} />; })}</ol>
    </section>
  ))}
</Base>
